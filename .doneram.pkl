// Version pins this repo tracks. Each one is a literal in the file that
// consumes it. This file records where those literals are and how to
// resolve the latest value.
//
// A site that matches a different number of times than `expect` fails the
// run. A pattern that silently stops matching is how a pin goes stale
// unnoticed.
//
// The schema is inlined so this file evaluates today. It amends doneram's
// published Config.pkl once doneram ships a pkl package.

class Site {
  /// Repo-relative path to the file holding the literal.
  file: String
  /// Regex with exactly one capture group around the version.
  pattern: String
  expect: Int(this > 0) = 1
}

class Tool {
  resolver: String?
  /// Name to query when it differs from the map key, e.g. "owner/repo".
  resolverName: String?
  sites: Listing<Site> = new {}
}

local ciYml = ".github/workflows/ci_pipeline.yml"
local publishYml = ".github/workflows/publish.yml"
local updateDocsYml = ".github/workflows/update_docs.yml"
local setupActionYml = ".github/actions/setup/action.yml"
local mkdocsYml = "mkdocs.yml"

/// A `uses: owner/repo@<sha> # <tag>` GitHub Action pin, one capture group
/// spanning the sha and the tag together, since github-action patches both
/// as a single resolved value.
local function actionPin(action: String, sourceFile: String, count: Int): Site = new {
  file = sourceFile
  pattern = #"\#(action)@([0-9a-f]{40} # v[\d.]+)"#
  expect = count
}

tools: Mapping<String, Tool> = new {
  ["checkout"] = new {
    resolver = "github-action"
    resolverName = "actions/checkout"
    sites = new {
      actionPin("actions/checkout", ciYml, 3)
      actionPin("actions/checkout", publishYml, 1)
      actionPin("actions/checkout", updateDocsYml, 1)
    }
  }
  ["download-artifact"] = new {
    resolver = "github-action"
    resolverName = "actions/download-artifact"
    sites = new { actionPin("actions/download-artifact", publishYml, 3) }
  }
  ["gh-action-pypi-publish"] = new {
    // Tracks the `release/v1` branch, not a tag: pypa republishes fixes onto
    // it rather than moving a version tag, so a tag-to-sha resolve doesn't
    // apply here.
    resolver = "github-branch"
    resolverName = "pypa/gh-action-pypi-publish@release/v1"
    sites = new {
      new Site {
        file = publishYml
        pattern = #"pypa/gh-action-pypi-publish@([0-9a-f]{40}) # release/v1"#
        expect = 2
      }
    }
  }
  ["pyright-action"] = new {
    resolver = "github-action"
    resolverName = "jakebailey/pyright-action"
    sites = new { actionPin("jakebailey/pyright-action", ciYml, 1) }
  }
  ["setup-python"] = new {
    resolver = "github-action"
    resolverName = "actions/setup-python"
    sites = new { actionPin("actions/setup-python", publishYml, 1) }
  }
  ["setup-uv"] = new {
    resolver = "github-action"
    resolverName = "astral-sh/setup-uv"
    sites = new {
      actionPin("astral-sh/setup-uv", publishYml, 1)
      actionPin("astral-sh/setup-uv", setupActionYml, 1)
    }
  }
  ["softprops-action-gh-release"] = new {
    resolver = "github-action"
    resolverName = "softprops/action-gh-release"
    sites = new { actionPin("softprops/action-gh-release", publishYml, 1) }
  }
  ["tablesort"] = new {
    resolver = "cdnjs"
    resolverName = "tablesort@tristen/tablesort"
    sites = new {
      new Site {
        file = mkdocsYml
        pattern = #"cdnjs\.cloudflare\.com/ajax/libs/tablesort/([\d.]+)/tablesort\.min\.js"#
      }
    }
  }
  ["upload-artifact"] = new {
    resolver = "github-action"
    resolverName = "actions/upload-artifact"
    sites = new { actionPin("actions/upload-artifact", publishYml, 1) }
  }
}
